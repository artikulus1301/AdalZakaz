# Скопируйте в .env и заполните.

# --- LLM: провайдер xKiro (OpenAI-совместимый API), модели Qwen ---
# Без ключа приложение работает в демо-режиме (детерминированные эвристики вместо модели).
# Список моделей: https://api.xkiro.com/v1/models  (ID в формате vendor/model)
LLM_PROVIDER=xKiro
LLM_API_KEY=
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_TEXT_MODEL=qwen/qwen3.7-plus:free
LLM_VISION_MODEL=qwen/qwen3-vl-plus:free
# Распознавание речи (ru/kk) через omni-модель. Альтернатива: qwen/qwen3.5-omni-plus:free
LLM_SPEECH_MODEL=qwen/qwen3.8-omni-flash:free
LLM_TIMEOUT=60

# --- Kaspi Магазин (без токена — демо-заказы) ---
KASPI_TOKEN=
KASPI_BASE_URL=https://kaspi.kz/shop/api/v2

# --- Приложение ---
ADAL_SELLER_PASSWORD=demo
# Адрес, который попадёт в ссылки и QR для покупателей (для телефона в той же сети — IP компьютера)
PUBLIC_BASE_URL=http://localhost:8000
ADAL_SEED_DEMO=1
ADAL_TZ=Asia/Almaty
MAX_UPLOAD_MB=50
